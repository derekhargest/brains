{
  "name": "brains!!!",
  "version": "1.0.0",
  "description": "AI Memory System using vector embeddings",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "build": "cd frontend && npm install && npm run build",
    "start": "node server.js",
    "start:frontend": "cd frontend && npm start",
    "start:backend": "node server.js",
    "dev": "nodemon server.js",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --config=jest.config.js",
    "test:patterns": "node backend/test/conceptPatterns.test.js",
    "test:nlp": "node backend/test/nlpPatternDetector.test.js",
    "test:system": "node backend/test/systemIntegrationTest.js",
    "check:qdrant": "node scripts/checkQdrant.js",
    "bulk-upload": "node backend/scripts/bulkUpload.js",
    "test:api": "node backend/scripts/apiTestClient.js",
    "full-test": "node backend/scripts/fullSystemTest.js",
    "check-db": "node backend/scripts/checkQdrant.js",
    "test-flow": "node backend/scripts/testFullFlow.js",
    "test:unit": "NODE_OPTIONS=--experimental-vm-modules jest --config=jest.config.js",
    "test:e2e": "NODE_OPTIONS=--experimental-vm-modules jest --config=e2e.config.js",
    "coverage": "NODE_OPTIONS=--experimental-vm-modules jest --coverage --config=jest.config.js",
    "test:mvp": "node backend/test/mvpTest.js",
    "test-server": "node backend/testServer.js"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "dependencies": {
    "@qdrant/js-client-rest": "^1.6.0",
    "@types/cron": "^2.0.1",
    "@types/joi": "^17.2.2",
    "axios": "^1.8.1",
    "chart.js": "^4.4.8",
    "concurrently": "^9.1.2",
    "cors": "^2.8.5",
    "cron": "^4.1.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "fs-extra": "^11.3.0",
    "gpt-3-encoder": "^1.1.4",
    "gray-matter": "^4.0.3",
    "joi": "^17.13.3",
    "markdown-it": "^14.1.0",
    "multer": "^1.4.5-lts.1",
    "natural": "^6.5.0",
    "node-cron": "^3.0.2",
    "openai": "^4.86.2",
    "pg": "^8.13.3",
    "react-chat-engine-advanced": "^0.1.28",
    "slugify": "^1.6.6",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "uuid": "^9.0.1",
    "vis-network": "^9.1.9"
  },
  "devDependencies": {
    "@babel/core": "^7.26.9",
    "@babel/preset-env": "^7.26.9",
    "@babel/register": "^7.25.9",
    "@jest/globals": "^29.7.0",
    "@types/node": "^22.13.9",
    "babel-jest": "^29.7.0",
    "chai": "^4.5.0",
    "jest": "^29.7.0",
    "mocha": "^11.1.0",
    "nodemon": "^3.0.1",
    "sinon": "^15.0.1",
    "supertest": "^6.3.3",
    "vite": "^6.2.0"
  }
}
